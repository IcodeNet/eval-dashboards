---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { routeForDocPath } from '../../plugins/rewrite-doc-links.mjs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: routeForDocPath(doc.id) || undefined },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const route = routeForDocPath(`${doc.id}.md`);
const { Content, headings } = await render(doc);
const title = headings.find((heading) => heading.depth === 1)?.text ?? doc.id;
---
<DocLayout title={title} route={route}>
  <article>
    <Content />
  </article>
</DocLayout>
