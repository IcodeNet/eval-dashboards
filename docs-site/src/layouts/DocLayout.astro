---
import { BASE } from '../site';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href={`${BASE}/styles.css`} />
    <title>{title} · eval-dashboards docs</title>
  </head>
  <body>
    <div class="container">
      <header>
        <h1><a href={`${BASE}/v1/`}>eval-dashboards docs</a></h1>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
