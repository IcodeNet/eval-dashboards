---
import { BASE } from '../site';
import Sidebar from '../components/Sidebar.astro';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  route: string;
}
const { title, route } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href={`${BASE}/styles.css`} />
    <link rel="stylesheet" href={`${BASE}/docs.css`} />
    <title>{title} · eval-dashboards docs</title>
  </head>
  <body>
    <div class="docs-shell">
      <header class="docs-top">
        <button class="sidebar-toggle" type="button" aria-controls="docs-sidebar" aria-expanded="false">Menu</button>
        <a class="docs-title" href={`${BASE}/docs/`}>
          <img class="docs-logo" src={`${BASE}/images/eval-dashboards-icon.svg`} alt="" width="32" height="32" />
          <span>eval-dashboards docs</span>
        </a>
        <Search />
        <a class="docs-legacy" href={`${BASE}/v1/`}>v1 pages</a>
      </header>
      <div class="docs-body">
        <div id="docs-sidebar" class="docs-sidebar-wrap">
          <Sidebar currentRoute={route} />
        </div>
        <main class="docs-main">
          <slot />
        </main>
      </div>
      <footer class="docs-footer">
        <img class="langfuse-mark" src={`${BASE}/images/langfuse-wordart-white.svg`} alt="Langfuse" height="22" />
        <p>
          eval-dashboards is an independent tool. It is not made, sponsored or endorsed by Langfuse. The Langfuse name
          and logo belong to Langfuse GmbH / Finto Technologies Inc. and are shown unmodified, only to say which
          product the Langfuse import and guide work with.
        </p>
      </footer>
    </div>
    <script is:inline src={`${BASE}/copy-code.js`}></script>
    <script is:inline>
      const toggle = document.querySelector('.sidebar-toggle');
      const wrap = document.getElementById('docs-sidebar');
      toggle.addEventListener('click', () => {
        const open = wrap.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      document.querySelector('.sidebar a[aria-current="page"]')?.scrollIntoView({ block: 'center' });
    </script>
  </body>
</html>
