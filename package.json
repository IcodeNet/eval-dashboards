{
  "name": "@icodenet/eval-dashboards",
  "version": "0.7.0",
  "description": "Beautiful, themeable HTML dashboards, quality gates, and publishing for AI agent eval runs.",
  "type": "module",
  "author": "icodenet <byronth@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IcodeNet/eval-dashboards.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/eval-report-v1.schema.json": "./schemas/eval-report-v1.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "eval-dashboards": "dist/cli/index.js",
    "evd": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "docs",
    "skills/eval-dashboards-adopt/SKILL.md",
    "examples/**/*.md",
    "examples/basic-json/*.json",
    "examples/agent-quality-preset/**",
    "examples/llm-agent-evals/*.ts",
    "examples/vitest-evals/*.ts",
    "examples/jest-custom-reporter/*.ts",
    "examples/github-actions/*.yml",
    "examples/azure-devops/*.yml",
    "examples/benchmark-packs/*.json",
    "examples/report-power-artifacts/**"
  ],
  "scripts": {
    "assets:regenerate": "tsx scripts/regenerate-release-assets.ts",
    "assets:verify": "tsx scripts/verify-release-assets.ts",
    "artifacts:report-power": "./scripts/generate-report-power-artifacts.sh",
    "build": "tsup",
    "cli": "node dist/cli/index.js",
    "cli:dev": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts",
    "example:llm-agent-evals": "tsx examples/llm-agent-evals/run-local-agent-evals.ts",
    "example:llm-agent-report": "pnpm example:llm-agent-evals && pnpm dev report --input=examples/llm-agent-evals/.evals_output --reporter=html --reporter=text --report-dir=eval-report",
    "example:financial-domain-ollama-evals": "tsx examples/financial-domain-ollama-evals/run-financial-domain-evals.ts",
    "example:financial-domain-ollama-report": "pnpm example:financial-domain-ollama-evals && pnpm dev report --input=examples/financial-domain-ollama-evals/.evals_output --reporter=html --reporter=text --report-dir=eval-report",
    "metrics:adoption": "tsx scripts/collect-adoption-metrics.ts",
    "prepare": "node -e \"const fs=require('fs'); if (!fs.existsSync('.git')) { console.log('skip lefthook install (no .git)'); process.exit(0); } try { require('child_process').execSync('lefthook install', { stdio: 'inherit' }); } catch (error) { console.warn('skip lefthook install (optional binary unavailable):', error && error.message ? error.message : error); }\"",
    "prepack": "pnpm build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "release:prepare": "pnpm check && pnpm assets:verify",
    "schema:generate": "tsx scripts/sync-eval-report-v1-schema.ts",
    "schema:check": "pnpm schema:generate && git diff --exit-code -- schemas/eval-report-v1.schema.json",
    "verify:cli": "./scripts/verify-cli-init-and-completion.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "evals",
    "evaluation",
    "reports",
    "llm-evals",
    "testing",
    "quality-gates"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^22.0.0",
    "lefthook": "^1.13.4",
    "playwright": "^1.55.0",
    "semantic-release": "^24.2.7",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
